# Public app URL. Use https://dh.gs-net.co.uk in development on the server.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Existing external Docker network shared with the Caddy container.
CADDY_NETWORK=caddy

# SQLite prototype database. In Docker this file lives in the mounted /app/data volume.
DATABASE_URL=file:./dev.db

# The app stays fully usable with seeded demo data when these are blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional API switches. Keep Gmail disabled until the restricted scope is approved.
ENABLE_CLASSROOM_API=false
ENABLE_GMAIL_API=false
ENABLE_CALENDAR_API=false

# Demo mode provides a no-credentials preview and local Kanban persistence.
DEMO_MODE=true

# Optional allow-list for the single-student prototype.
# Leave blank to allow any verified Google account during development.
ALLOWED_GOOGLE_EMAIL=
ALLOWED_GOOGLE_DOMAIN=

# Comma-separated Google accounts permitted to use /admin.
ADMIN_GOOGLE_EMAILS=

# Local admin access, available before Google OAuth is configured.
ADMIN_LOCAL_USERNAME=dixie-admin
ADMIN_LOCAL_PASSWORD=

# Internal Prometheus scrape authentication. Generate a long random value.
METRICS_BEARER_TOKEN=

# Separate Grafana login. Do not reuse NEXTAUTH_SECRET.
GRAFANA_ADMIN_USER=dixie-admin
GRAFANA_ADMIN_PASSWORD=

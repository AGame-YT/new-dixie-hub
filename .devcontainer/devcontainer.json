{
  "name": "Dixie Hub",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Dixie Hub",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash scripts/dev-setup.sh",
  "postAttachCommand": "npm run dev",
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma"]
    }
  }
}
